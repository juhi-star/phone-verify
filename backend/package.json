{
  "name": "phone-verification-api",
  "version": "1.0.0",
  "description": "Phone number verification API using Node.js, Express, MongoDB, and Twilio",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "prod": "npm run build:frontend && node src/server.js",
    "dev": "nodemon src/server.js",
    "build:frontend": "cd ../frontend && npm run build",
    "test": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "twilio": "^4.20.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
